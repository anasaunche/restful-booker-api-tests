{
  "info": {
    "name": "Restful-Booker API – Test Suite",
    "description": "Portfolio API test suite for the public Restful-Booker API (https://restful-booker.herokuapp.com).\n\nStructure:\n- 00 Health – service availability\n- 01 Auth – token generation (token is stored and reused automatically)\n- 02 Booking lifecycle – chained CRUD flow: create → read → search → update → partial update → delete → verify deletion\n- 03 Security & error handling – unauthorised writes, missing resources\n- 04 Known defects – tests that assert the CORRECT behaviour and currently FAIL. Each is tagged with a bug ID (RB-01…RB-07) that matches the EN/ES bug report pack.\n\nRun: open the collection runner, select the \"Restful-Booker\" environment and run all folders in order. CLI: newman run collection.json -e environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level checks run after every request",
          "pm.test('Response time is under 3000 ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Ping – service is up",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (documented health-check code)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Create token – valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Token is a non-empty string', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Booking lifecycle",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh, realistic test data for every run",
                  "const first = pm.variables.replaceIn('{{$randomFirstName}}');",
                  "const last = pm.variables.replaceIn('{{$randomLastName}}');",
                  "const price = Math.floor(Math.random() * 400) + 50;",
                  "const day = 24 * 60 * 60 * 1000;",
                  "const checkin = new Date(Date.now() + 30 * day).toISOString().slice(0, 10);",
                  "const checkout = new Date(Date.now() + 33 * day).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('firstname', first);",
                  "pm.collectionVariables.set('lastname', last);",
                  "pm.collectionVariables.set('totalprice', price);",
                  "pm.collectionVariables.set('checkin', checkin);",
                  "pm.collectionVariables.set('checkout', checkout);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a numeric bookingid', () => pm.expect(body.bookingid).to.be.a('number'));",
                  "pm.test('Echoes the submitted booking', () => {",
                  "  pm.expect(body.booking.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "  pm.expect(body.booking.lastname).to.eql(pm.collectionVariables.get('lastname'));",
                  "  pm.expect(body.booking.totalprice).to.eql(Number(pm.collectionVariables.get('totalprice')));",
                  "  pm.expect(body.booking.bookingdates.checkin).to.eql(pm.collectionVariables.get('checkin'));",
                  "});",
                  "pm.collectionVariables.set('bookingId', body.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "  properties: {",
                  "    firstname: { type: 'string' },",
                  "    lastname: { type: 'string' },",
                  "    totalprice: { type: 'number' },",
                  "    depositpaid: { type: 'boolean' },",
                  "    bookingdates: {",
                  "      type: 'object',",
                  "      required: ['checkin', 'checkout'],",
                  "      properties: { checkin: { type: 'string' }, checkout: { type: 'string' } }",
                  "    },",
                  "    additionalneeds: { type: 'string' }",
                  "  }",
                  "};",
                  "pm.test('Body matches booking JSON schema', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('Data matches what was created', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "  pm.expect(b.bookingdates.checkout).to.eql(pm.collectionVariables.get('checkout'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search bookings by name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname={{lastname}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                },
                {
                  "key": "lastname",
                  "value": "{{lastname}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Results include the new booking', () => {",
                  "  const ids = pm.response.json().map(b => b.bookingid);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update booking (PUT, token auth)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('additionalneeds was updated', () => pm.expect(pm.response.json().additionalneeds).to.eql('Late checkout'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Partial update (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}-updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('firstname changed', () => pm.expect(b.firstname).to.eql(pm.collectionVariables.get('firstname') + '-updated'));",
                  "pm.test('Other fields untouched', () => pm.expect(b.additionalneeds).to.eql('Late checkout'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete booking",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (documented delete code)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deleted booking returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Security & error handling",
      "item": [
